FROM node:24-slim

# Движок Prisma — нативный бинарник. На Alpine он собран под musl,
# и это самый частый источник падений; Prisma сама рекомендует slim
# при проблемах совместимости. openssl в slim-образе не предустановлен.
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# Заглушка только на время сборки: prisma.config.ts вызывает env("DATABASE_URL")
# и падает без него, хотя сам generate к базе не подключается.
# Именно ARG, а не ENV: ARG не остаётся в слоях образа и не перекроет
# настоящее значение, которое Vercel подставит в рантайме.
ARG DATABASE_URL="mongodb://placeholder:placeholder@localhost:27017/placeholder"

RUN npx prisma generate
RUN npm run build

CMD ["node", "dist/src/main.js"]
