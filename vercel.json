{
	"services": {
		"frontend": {
			"root": "frontend",
			"framework": "nuxtjs"
		},
		"backend": {
			"root": "backend",
			"framework": "nestjs",
			"entrypoint": "npm run start:prod"
		}
	},
	"rewrites": [
		{
			"source": "/api/v2(/.*)?",
			"destination": {
				"type": "service",
				"service": "backend"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"type": "service",
				"service": "frontend"
			}
		}
	]
}
