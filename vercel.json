{
	"services": {
		"frontend": {
			"root": "frontend",
			"framework": "nuxtjs"
		},
		"backend": {
			"root": "backend",
			"runtime": "container",
			"entrypoint": "Dockerfile.vercel"
		}
	},
	"crons": [
		{
			"path": "/api/v2/rates/cron/update",
			"schedule": "0 0 * * *"
		}
	],
	"rewrites": [
		{
			"source": "/api/v2(/.*)?",
			"destination": {
				"type": "service",
				"service": "backend"
			}
		},
		{
			"source": "/((?!_vercel/).*)",
			"destination": {
				"type": "service",
				"service": "frontend"
			}
		}
	]
}
